# Copy this file to .env and fill in your values:
#   cp .env.example .env

# App
APP_NAME="Debt Advisor API"
DEBUG=false

# Database (Postgres connection string, e.g. from Supabase > Project Settings > Database)
# For local testing you can use: sqlite:///./test.db
DATABASE_URL=postgresql://user:password@localhost:5432/debt_advisor

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Anthropic
ANTHROPIC_API_KEY=your-anthropic-api-key
